local csvloader = require("utils.csvloader")

local GRID_SIZE = 4
local CELL_SIZE = 80
local GRID_START_X = -135
local GRID_START_Y = 200
local TRAY_START_Y = -160
local ROW_SPACING = 80
local CARD_SCALE = 0.35
local PICK_RADIUS = 45

local PASTEL_COLORS = {
	vmath.vector4(1.0, 0.75, 0.75, 1.0),
	vmath.vector4(0.75, 0.85, 1.0, 1.0),
	vmath.vector4(0.75, 1.0, 0.8, 1.0),
	vmath.vector4(1.0, 0.95, 0.7, 1.0),
}
local PASTEL_LABEL_COLORS = {
	vmath.vector4(0.6, 0.2, 0.2, 1.0),
	vmath.vector4(0.2, 0.3, 0.6, 1.0),
	vmath.vector4(0.2, 0.5, 0.2, 1.0),
	vmath.vector4(0.5, 0.4, 0.1, 1.0),
}
local COMPLETED_GRID_COLOR = vmath.vector4(0.6, 1.0, 0.6, 1.0)
local COMPLETED_TRAY_COLOR = vmath.vector4(0.5, 0.8, 0.5, 1.0)
local HIGHLIGHT_COLOR = vmath.vector4(1.0, 1.0, 0.5, 1.0)

local state = {
	puzzle_words = {},
	grid = {},
	tray = {},
	valid_words = {},
	dragging = nil,
	row_completed = {},
	completed_count = 0,
	factory_url = nil,
}

local function grid_cell_position(row, col)
	local x = GRID_START_X + (col - 1) * (CELL_SIZE + 10)
	local y = GRID_START_Y - (row - 1) * ROW_SPACING
	return vmath.vector3(x, y, 0)
end

local function tray_card_position(row, col)
	local x = GRID_START_X + (col - 1) * (CELL_SIZE + 10)
	local y = TRAY_START_Y - (row - 1) * ROW_SPACING
	return vmath.vector3(x, y, 0)
end

local function shuffle(t)
	local n = #t
	for i = n, 2, -1 do
		local j = math.random(i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

local function spawn_cell(row, col)
	local pos = grid_cell_position(row, col)
	local id = factory.create(state.factory_url, pos, nil, { letter = string.byte(" ") })
	go.set_scale(CARD_SCALE, id)
	msg.post(id, "set_tint", { tint = PASTEL_COLORS[row] })
	return id
end

local function spawn_tray_card(row, col, letter)
	local pos = tray_card_position(row, col)
	local id = factory.create(state.factory_url, pos, nil, { letter = string.byte(letter) })
	go.set_scale(CARD_SCALE, id)
	msg.post(id, "set_tint", { tint = PASTEL_COLORS[row] })
	msg.post(id, "set_label_color", { color = PASTEL_LABEL_COLORS[row] })
	if row == 1 and col == 1 then
		local actual = go.get_position(id)
		print("DEBUG spawn pos: requested=", pos.x, pos.y, "actual=", actual.x, actual.y)
	end
	return id
end

local function update_grid_visual(row, col)
	local id = state.grid[row][col]
	if id then
		if state.puzzle_words[row] then
			msg.post(id, "set_tint", { tint = COMPLETED_GRID_COLOR })
		else
			msg.post(id, "set_tint", { tint = PASTEL_COLORS[row] })
		end
	end
end

local function check_row_complete(row)
	for col = 1, GRID_SIZE do
		local card = state.tray[row][col]
		if not card.grid_col then
			return false
		end
	end

	local word_chars = {}
	for col = 1, GRID_SIZE do
		for _, card in ipairs(state.tray[row]) do
			if card.grid_col == col then
				table.insert(word_chars, card.letter)
				break
			end
		end
	end
	local word = table.concat(word_chars)
	return state.valid_words[word] and word or nil
end

local function complete_row(row, word)
	state.row_completed[row] = true
	state.puzzle_words[row] = word
	state.completed_count = state.completed_count + 1

	for col = 1, GRID_SIZE do
		update_grid_visual(row, col)
		local card = state.tray[row][col]
		if card then
			msg.post(card.go_id, "set_tint", { tint = COMPLETED_TRAY_COLOR })
		end
	end

	msg.post("#gui", "row_completed", { row = row, word = word })

	if state.completed_count >= GRID_SIZE then
		msg.post("#gui", "game_won", {})
	end
end

local function place_card_on_grid(row, tray_col, grid_col)
	local card = state.tray[row][tray_col]
	card.grid_col = grid_col

	local pos = grid_cell_position(row, grid_col)
	go.set_position(pos, card.go_id)
	go.set_scale(CARD_SCALE, card.go_id)
	state.grid[row][grid_col] = card.go_id

	local result = check_row_complete(row)
	if result then
		complete_row(row, result)
	end
end

local function return_card_to_tray(row, tray_col)
	local card = state.tray[row][tray_col]
	if card.grid_col then
		state.grid[row][card.grid_col] = nil
		card.grid_col = nil
	end

	local pos = tray_card_position(row, tray_col)
	go.set_position(pos, card.go_id)
	go.set_scale(CARD_SCALE, card.go_id)
end

local function swap_cards(row, src_tray_col, dst_tray_col)
	local src_card = state.tray[row][src_tray_col]
	local dst_card = state.tray[row][dst_tray_col]
	local src_grid_col = src_card.grid_col
	local dst_grid_col = dst_card.grid_col

	src_card.grid_col = dst_grid_col
	dst_card.grid_col = src_grid_col

	if dst_grid_col then
		local pos = grid_cell_position(row, dst_grid_col)
		go.set_position(pos, src_card.go_id)
		state.grid[row][dst_grid_col] = src_card.go_id
	else
		local pos = tray_card_position(row, src_tray_col)
		go.set_position(pos, src_card.go_id)
		state.grid[row][src_grid_col] = nil
	end

	if src_grid_col then
		local pos = grid_cell_position(row, src_grid_col)
		go.set_position(pos, dst_card.go_id)
		state.grid[row][src_grid_col] = dst_card.go_id
	else
		local pos = tray_card_position(row, dst_tray_col)
		go.set_position(pos, dst_card.go_id)
		state.grid[row][dst_grid_col] = nil
	end

	if state.dragging then
		state.dragging.tray_col = dst_tray_col
	end
end

local function try_pickup(world_x, world_y)
	for row = 1, GRID_SIZE do
		if not state.row_completed[row] then
			for col = 1, GRID_SIZE do
				local card = state.tray[row][col]
				if card then
					local pos
					if card.grid_col then
						pos = grid_cell_position(row, card.grid_col)
					else
						pos = tray_card_position(row, col)
					end
					local hit = world_x >= pos.x - PICK_RADIUS and world_x <= pos.x + PICK_RADIUS
						and world_y >= pos.y - PICK_RADIUS and world_y <= pos.y + PICK_RADIUS
					if col == 1 and row == 1 and not card.grid_col then
						print("DEBUG pickup row1 col1: world=", world_x, world_y, "card=", pos.x, pos.y, "hit=", hit)
					end
					if hit then
						state.dragging = {
							row = row,
							tray_col = col,
							go_id = card.go_id,
							start_pos = vmath.vector3(pos),
							offset_x = world_x - pos.x,
							offset_y = world_y - pos.y,
						}
						go.set_scale(CARD_SCALE * 1.2, card.go_id)
						return true
					end
				end
			end
		end
	end
	return false
end

local function try_drop(world_x, world_y)
	if not state.dragging then
		return
	end

	local drag = state.dragging
	local row = drag.row
	local tray_col = drag.tray_col
	local card = state.tray[row][tray_col]

	local picked_grid_col = card.grid_col

	for grid_col = 1, GRID_SIZE do
		local pos = grid_cell_position(row, grid_col)
		if world_x >= pos.x - PICK_RADIUS and world_x <= pos.x + PICK_RADIUS
		and world_y >= pos.y - PICK_RADIUS and world_y <= pos.y + PICK_RADIUS then
			if state.grid[row][grid_col] then
				for _, other in ipairs(state.tray[row]) do
					if other.grid_col == grid_col and other ~= card then
						local other_tray_col = nil
						for tc = 1, GRID_SIZE do
							if state.tray[row][tc] == other then
								other_tray_col = tc
								break
							end
						end
						if picked_grid_col then
							swap_cards(row, tray_col, other_tray_col)
						else
							state.grid[row][grid_col] = nil
							other.grid_col = nil
							local other_pos = tray_card_position(row, other_tray_col)
							go.set_position(other_pos, other.go_id)
							place_card_on_grid(row, tray_col, grid_col)
							other_tray_col = nil
							for tc = 1, GRID_SIZE do
								if state.tray[row][tc] == other then
									other_tray_col = tc
									break
								end
							end
							local pos2 = tray_card_position(row, other_tray_col)
							go.set_position(pos2, other.go_id)
							go.set_scale(CARD_SCALE, other.go_id)
						end
						state.dragging = nil
						return
					end
				end
			else
				if picked_grid_col then
					state.grid[row][picked_grid_col] = nil
				end
				place_card_on_grid(row, tray_col, grid_col)
				state.dragging = nil
				return
			end
		end
	end

	return_card_to_tray(row, tray_col)
	state.dragging = nil
end

function init(self)
	math.randomseed(math.floor(socket.gettime() * 1000000))

	for k, v in pairs(camera.get_cameras()) do
		print("DEBUG camera:", k, v)
	end

	state.factory_url = msg.url("#card_factory")

	local csv_data = csvloader.load_resource("/custom_resources/words/squares_en_4.csv")
	if not csv_data or #csv_data < 2 then
		print("ERROR: Failed to load squares_en_4.csv")
		return
	end

	for i = 2, #csv_data do
		local line = csv_data[i]
		for j = 1, GRID_SIZE do
			local word = line[j]
			if word and #word == GRID_SIZE then
				state.valid_words[word] = true
			end
		end
	end

	local puzzle_idx = math.random(2, #csv_data)
	local puzzle_line = csv_data[puzzle_idx]

	for row = 1, GRID_SIZE do
		state.puzzle_words[row] = nil
		state.row_completed[row] = false
		state.grid[row] = {}
		state.tray[row] = {}

		local word = puzzle_line[row]
		local letters = {}
		for i = 1, #word do
			letters[i] = string.sub(word, i, i)
		end
		shuffle(letters)

		for col = 1, GRID_SIZE do
			local cell_id = spawn_cell(row, col)
			state.grid[row][col] = cell_id

			local card_id = spawn_tray_card(row, col, letters[col])
			state.tray[row][col] = {
				go_id = card_id,
				letter = letters[col],
				grid_col = nil,
			}
		end
	end

	msg.post("camera#camera", "acquire_camera_focus")
	msg.post(".", "acquire_input_focus")
	print("Anagramm puzzle loaded. Row words:", puzzle_line[1], puzzle_line[2], puzzle_line[3], puzzle_line[4])
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then
		return false
	end

	if state.completed_count >= GRID_SIZE then
		return false
	end

	local world_pos = camera.screen_xy_to_world(action.screen_x, action.screen_y)
	local wx = world_pos.x
	local wy = world_pos.y

	if action.pressed then
		print("DEBUG EVENT pressed: screen=", action.screen_x, action.screen_y, "world=", wx, wy)
		if try_pickup(wx, wy) then
			return true
		end
		return false

	elseif action.released then
		print("DEBUG EVENT released: screen=", action.screen_x, action.screen_y, "world=", wx, wy, "dragging=", state.dragging ~= nil)
		if state.dragging then
			try_drop(wx, wy)
			return true
		end
		return false

	else
		-- Handles action.dragged and any other events during press
		if state.dragging then
			local drag = state.dragging
			local new_pos = vmath.vector3(wx - drag.offset_x, wy - drag.offset_y, 0)
			go.set_position(new_pos, drag.go_id)
			return true
		end
		return false
	end

	return false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("restart") then
		for row = 1, GRID_SIZE do
			for col = 1, GRID_SIZE do
				if state.grid[row][col] then
					go.delete(state.grid[row][col])
				end
				if state.tray[row][col] and state.tray[row][col].go_id then
					go.delete(state.tray[row][col].go_id)
				end
			end
		end
		init(self)
	end
end