local csvloader = require("utils.csvloader")

local CELL_SIZE = 128
local CELL_SCALE = 0.5
local CELL_GAP = 2
local CELL_STEP = CELL_SIZE * CELL_SCALE + CELL_GAP
local GRID_START_Y = 200
local TRAY_START_Y = -160
local ROW_SPACING = CELL_STEP
local PICK_RADIUS = 32
local BAR_SCALE_Y = 0.6
local LETTER_Z = 0.2

local PASTEL_COLORS = {
	vmath.vector4(1.0, 0.75, 0.75, 1.0),
	vmath.vector4(0.75, 0.85, 1.0, 1.0),
	vmath.vector4(0.75, 1.0, 0.8, 1.0),
	vmath.vector4(1.0, 0.95, 0.7, 1.0),
	vmath.vector4(0.85, 0.75, 1.0, 1.0),
	vmath.vector4(1.0, 0.8, 0.9, 1.0),
}
local PASTEL_LABEL_COLORS = {
	vmath.vector4(0.6, 0.2, 0.2, 1.0),
	vmath.vector4(0.2, 0.3, 0.6, 1.0),
	vmath.vector4(0.2, 0.5, 0.2, 1.0),
	vmath.vector4(0.5, 0.4, 0.1, 1.0),
	vmath.vector4(0.3, 0.2, 0.6, 1.0),
	vmath.vector4(0.6, 0.2, 0.4, 1.0),
}
local COMPLETED_GRID_COLOR = vmath.vector4(0.6, 1.0, 0.6, 1.0)
local COMPLETED_TRAY_COLOR = vmath.vector4(0.5, 0.8, 0.5, 1.0)

local state = {
	puzzle_words = {},
	grid = {},
	letters = {},
	bars = {},
	valid_words = {},
	dragging = nil,
	row_completed = {},
	completed_count = 0,
	factory_url = nil,
	grid_size = 4,
}

local function utf8_chars(s)
	local out = {}
	local i = 1
	local len = #s
	while i <= len do
		local b = string.byte(s, i)
		local size
		if b < 0x80 then size = 1
		elseif b < 0xC0 then size = 1
		elseif b < 0xE0 then size = 2
		elseif b < 0xF0 then size = 3
		else size = 4 end
		out[#out + 1] = string.sub(s, i, i + size - 1)
		i = i + size
	end
	return out
end

local function grid_start_x()
	local grid_width = state.grid_size * CELL_STEP - CELL_GAP
	return -grid_width / 2
end

local function grid_cell_position(row, col)
	local x = grid_start_x() + (col - 1) * CELL_STEP
	local y = GRID_START_Y - (row - 1) * ROW_SPACING
	return vmath.vector3(x, y, 0)
end

local function shuffle(t)
	local n = #t
	for i = n, 2, -1 do
		local j = math.random(i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

local function spawn_cell(row, col)
	local pos = grid_cell_position(row, col)
	local id = factory.create(state.factory_url, pos)
	go.set_scale(CELL_SCALE, id)
	msg.post(id, "set_tint", { tint = PASTEL_COLORS[row] })
	msg.post(id, "set_letter", { letter = "" })
	return id
end

local function spawn_bar(row)
	local grid_width = state.grid_size * CELL_STEP - CELL_GAP
	local cx = grid_start_x() + grid_width / 2
	local y = TRAY_START_Y - (row - 1) * ROW_SPACING
	local sx = grid_width / (CELL_SIZE * CELL_SCALE)
	local pos = vmath.vector3(cx, y, -0.1)
	local id = factory.create(state.factory_url, pos)
	go.set_scale(vmath.vector3(sx, BAR_SCALE_Y, 1), id)
	msg.post(id, "set_tint", { tint = PASTEL_COLORS[row] })
	msg.post(id, "set_letter", { letter = "" })
	return id
end

local function spawn_letter(row, letter)
	local pos = vmath.vector3(0, 0, LETTER_Z)
	local id = factory.create(state.factory_url, pos)
	go.set_scale(CELL_SCALE, id)
	msg.post(id, "set_tint", { tint = vmath.vector4(1, 1, 1, 0) })
	msg.post(id, "set_label_color", { color = PASTEL_LABEL_COLORS[row] })
	msg.post(id, "set_letter", { letter = letter })
	return id
end

local function update_bar_layout(row)
	local on_bar = {}
	for i, letter in ipairs(state.letters[row]) do
		if not letter.grid_col then
			on_bar[#on_bar + 1] = i
		end
	end
	local count = #on_bar
	if count == 0 then return end

	local bar_left = grid_start_x()
	local bar_width = state.grid_size * CELL_STEP
	local spacing = bar_width / count

	for j, idx in ipairs(on_bar) do
		local x = bar_left + spacing * (j - 0.5)
		local y = TRAY_START_Y - (row - 1) * ROW_SPACING
		go.set_position(vmath.vector3(x, y, LETTER_Z), state.letters[row][idx].go_id)
	end
end

local function update_grid_visual(row, col)
	local id = state.grid[row][col]
	if id then
		if state.row_completed[row] then
			msg.post(id, "set_tint", { tint = COMPLETED_GRID_COLOR })
		else
			msg.post(id, "set_tint", { tint = PASTEL_COLORS[row] })
		end
	end
end

local function reset_row_tint(row)
	for col = 1, state.grid_size do
		update_grid_visual(row, col)
	end
	if state.bars[row] then
		msg.post(state.bars[row], "set_tint", { tint = PASTEL_COLORS[row] })
	end
end

local function check_row_complete(row)
	local grid_letters = {}
	for _, letter in ipairs(state.letters[row]) do
		if letter.grid_col then
			grid_letters[letter.grid_col] = letter.letter
		end
	end
	if #grid_letters < state.grid_size then return false end
	for col = 1, state.grid_size do
		if not grid_letters[col] then return false end
	end

	local word_chars = {}
	for col = 1, state.grid_size do
		word_chars[col] = grid_letters[col]
	end
	local word = table.concat(word_chars)
	return state.valid_words[word] and word or nil
end

local function complete_row(row, word)
	state.row_completed[row] = true
	state.puzzle_words[row] = word
	state.completed_count = state.completed_count + 1

	for col = 1, state.grid_size do
		update_grid_visual(row, col)
	end

	if state.bars[row] then
		msg.post(state.bars[row], "set_tint", { tint = COMPLETED_TRAY_COLOR })
	end

	msg.post("go#gui", "row_completed", { row = row, word = word, total = state.grid_size })

	if state.completed_count >= state.grid_size then
		msg.post("go#gui", "game_won", {})
	end
end

local function try_pickup(world_x, world_y)
	for row = 1, state.grid_size do
		if not state.row_completed[row] then
			for i, letter in ipairs(state.letters[row]) do
				local pos = go.get_position(letter.go_id)
				local hit = world_x >= pos.x - PICK_RADIUS and world_x <= pos.x + PICK_RADIUS
					and world_y >= pos.y - PICK_RADIUS and world_y <= pos.y + PICK_RADIUS
				if hit then
					state.dragging = {
						row = row,
						letter_idx = i,
						go_id = letter.go_id,
						start_pos = vmath.vector3(pos),
						offset_x = world_x - pos.x,
						offset_y = world_y - pos.y,
					}
					go.set_scale(CELL_SCALE * 1.2, letter.go_id)
					return true
				end
			end
		end
	end
	return false
end

local function try_drop(world_x, world_y)
	if not state.dragging then return end

	local drag = state.dragging
	local row = drag.row
	local letter = state.letters[row][drag.letter_idx]

	for grid_col = 1, state.grid_size do
		local pos = grid_cell_position(row, grid_col)
		if world_x >= pos.x - PICK_RADIUS and world_x <= pos.x + PICK_RADIUS
		and world_y >= pos.y - PICK_RADIUS and world_y <= pos.y + PICK_RADIUS then
			local occupant = nil
			for _, l in ipairs(state.letters[row]) do
				if l.grid_col == grid_col then
					occupant = l
					break
				end
			end
			if occupant and occupant ~= letter then
				occupant.grid_col = nil
				update_bar_layout(row)
			end

			letter.grid_col = grid_col
			local grid_pos = grid_cell_position(row, grid_col)
			grid_pos.z = LETTER_Z
			go.set_position(grid_pos, letter.go_id)
			go.set_scale(CELL_SCALE, letter.go_id)
			state.dragging = nil

			local result = check_row_complete(row)
			if result then complete_row(row, result) end
			return
		end
	end

	letter.grid_col = nil
	update_bar_layout(row)
	go.set_scale(CELL_SCALE, letter.go_id)
	state.dragging = nil
end

local function pick_puzzle_words(csv_data)
	local candidates = {}
	for i = 2, #csv_data do
		local line = csv_data[i]
		local word = line[1]
		local flag = tonumber(line[4])
		if word and #word == state.grid_size * 2 then
			if flag == 0 or flag == 1 then
				candidates[#candidates + 1] = word
			end
		end
	end

	if #candidates < state.grid_size then
		print("ERROR: Not enough words of length " .. state.grid_size * 2 .. " in dictionary, found " .. #candidates)
		return nil
	end

	shuffle(candidates)

	local picked = {}
	for i = 1, state.grid_size do
		picked[i] = candidates[i]
	end
	return picked
end

local function build_valid_word_set(csv_data)
	local valid = {}
	for i = 2, #csv_data do
		local line = csv_data[i]
		local word = line[1]
		local flag = tonumber(line[4])
		if word and #word == state.grid_size * 2 then
			if flag == 0 or flag == 1 then
				valid[word] = true
			end
		end
	end
	return valid
end

local function delete_all_objects()
	for row in pairs(state.grid) do
		for col in pairs(state.grid[row]) do
			if state.grid[row][col] then
				go.delete(state.grid[row][col])
			end
		end
		if state.letters[row] then
			for _, letter in ipairs(state.letters[row]) do
				if letter.go_id then
					go.delete(letter.go_id)
				end
			end
		end
		if state.bars[row] then
			go.delete(state.bars[row])
		end
	end
	state.grid = {}
	state.letters = {}
	state.bars = {}
end

local function do_init(self)
	math.randomseed(math.floor(socket.gettime() * 1000000))
	state.factory_url = msg.url("#cell_factory")

	local csv_data = csvloader.load_resource("/custom_resources/words/WordList_RU.csv")
	if not csv_data or #csv_data < 2 then
		print("ERROR: Failed to load WordList_RU.csv")
		return
	end

	local words = pick_puzzle_words(csv_data)
	if not words then return end

	state.valid_words = build_valid_word_set(csv_data)
	state.completed_count = 0

	for row = 1, state.grid_size do
		state.puzzle_words[row] = nil
		state.row_completed[row] = false
		state.grid[row] = {}
		state.letters[row] = {}
		state.bars[row] = nil

		for col = 1, state.grid_size do
			local cell_id = spawn_cell(row, col)
			state.grid[row][col] = cell_id
		end

		local bar_id = spawn_bar(row)
		state.bars[row] = bar_id

		local word = words[row]
		local letters = utf8_chars(word)
		shuffle(letters)

		for i = 1, state.grid_size do
			local letter_id = spawn_letter(row, letters[i])
			state.letters[row][i] = {
				go_id = letter_id,
				letter = letters[i],
				grid_col = nil,
			}
		end

		update_bar_layout(row)
	end

	msg.post("camera#camera", "acquire_camera_focus")
	msg.post(".", "acquire_input_focus")
	print("Anagram puzzle loaded. Words: " .. table.concat(words, ", "))
end

function init(self)
	do_init(self)
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then
		return false
	end

	if state.completed_count >= state.grid_size then
		return false
	end

	local world_pos = camera.screen_xy_to_world(action.screen_x, action.screen_y)
	local wx = world_pos.x
	local wy = world_pos.y

	if action.pressed then
		if try_pickup(wx, wy) then
			return true
		end
		return false

	elseif action.released then
		if state.dragging then
			try_drop(wx, wy)
			return true
		end
		return false

	else
		if state.dragging then
			local drag = state.dragging
			local new_pos = vmath.vector3(wx - drag.offset_x, wy - drag.offset_y, 0)
			go.set_position(new_pos, drag.go_id)
			return true
		end
		return false
	end

	return false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("restart") then
		delete_all_objects()
		do_init(self)

	elseif message_id == hash("reset_letters") then
		for row = 1, state.grid_size do
			state.row_completed[row] = false
			state.puzzle_words[row] = nil
			for _, letter in ipairs(state.letters[row]) do
				letter.grid_col = nil
			end
			update_bar_layout(row)
			reset_row_tint(row)
		end
		state.completed_count = 0
		msg.post("go#gui", "reset_ui", {})

	elseif message_id == hash("set_grid_size") then
		local new_size = message.size
		if new_size == state.grid_size then return end
		delete_all_objects()
		state.grid_size = new_size
		do_init(self)
		msg.post("go#gui", "size_changed", { size = new_size })
	end
end