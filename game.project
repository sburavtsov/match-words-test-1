[project]
title = MW1
version = 0.0.1
dependencies#0 = https://github.com/britzl/monarch/archive/refs/tags/6.0.1.zip
dependencies#1 = https://github.com/indiesoftby/defold-object-interpolation/archive/refs/tags/1.3.1.zip
dependencies#2 = https://github.com/indiesoftby/defold-sharp-sprite/archive/refs/tags/1.0.0.zip
dependencies#3 = https://github.com/thejustinwalsh/defold-xmath/archive/refs/heads/main.zip

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 1024
height = 1024
high_dpi = 1

[physics]
scale = 0.02

[script]
shared_state = 1

[particle_fx]
max_count = 256
max_particle_count = 4096

[sprite]
max_count = 256

[library]
include_dirs = 

[label]
max_count = 256

