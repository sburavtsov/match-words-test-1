local BLOCKSIZE = 96
local EDGE = 80
local BOTTOM_EDGE = 80
local BOARDWIDTH = 7
local BOARDHEIGHT = 7

local TYPE_PLAIN = hash("plain")
local TYPE_STRIPED_H = hash("striped-h")
local TYPE_STRIPED_V = hash("striped-v")
-- local type_bomb = hash("bomb")


--
-- INIT the board
--
function init(self)
	self.board = {}				-- Contains the board structure in 2D
	self.link = {}

	--
	-- Start the game
	--
	msg.post("#", "start_level")
	msg.post(".", "acquire_input_focus")

	--local csv = csvloader.load_resource("/custom_resources/words/WordList_RU.csv")


	--pprint(csv)
	
	-- 1. Load dictionary
	local dictionary = dictionary_service.init({ csv_path = "custom_resources/words/WordList_EN.csv" })

--[[
	local dictionary = dictionary_service.init({
		entries = {
			{word = "CAT", freq = 100},
			{word = "CATS", freq = 50},
			{word = "STAR", freq = 70},
			{word = "ART", freq = 60},
			{word = "RAT", freq = 55},
			{word = "TAR", freq = 45},
			{word = "QUICK", freq = 10}
		}
	})
	]]

	pprint(dictionary)
	
	-- 2. Initialize board
	self.board = board_service.init({
		dictionary = dictionary,
		pattern = {7, 6, 7, 6, 7, 6, 7},
		difficulty = 0.35,
		target_letters = {"A", "B", "C", "D", "E"},
		use_random_joker = true,
		use_pity_joker = true
	})

	print("=== INITIAL BOARD ===")
	pprint("\n")
	pprint(board_service.debug_dump(self.board))

	-- 3. Simulate a player move
	-- You'll need to replace these coordinates with actual player input
	local test_coords = {
		{x = 3, y = 5},
		{x = 3, y = 4},
		{x = 4, y = 4}
	}

	local result = move_resolver.resolve(self.board, test_coords, dictionary)

	if result.ok then
		print("=== MOVE RESOLVED ===")
		print("Word:", result.chosen_word)
		print("Valid words:", table.concat(result.valid_words, ", "))
		print("Targets collected:", result.targets_collected_now)
		print("Total collected:", result.total_targets_collected)
		print("Remaining:", result.targets_remaining)
		print("Booster:", result.booster_created or "none")
		print("Pity joker:", tostring(result.pity_injected))
		print("Win:", tostring(result.is_win))
		print("=== BOARD AFTER ===")
		print(board_service.debug_dump(self.board))
	else
		print("Move rejected:", result.error)
	end

end

--
-- Construct a new random board. It's a 2D table with origo in the
-- bottom left corner:
--
--  ...
-- (0,2) (1,2) (2,2)
-- (0,1) (1,1) (2,1)
-- (0,0) (1,0) (2,0) ...
--
-- Each slot stores the id of the game object that sits there, the x and y
-- position and the type, for easy searching. Storing the x and y position is
-- redundant but useful if we use the slots out of context, which we do at times.
--
local function build_board()
	local board = {}
	math.randomseed(os.time())
	local pos = vmath.vector3()
	local x = 0
	local y = 0
	for x = 0, BOARDWIDTH - 1 do
		pos.x = EDGE + BLOCKSIZE / 2 + BLOCKSIZE * x
		board[x] = {}
		local vlimit = BOARDHEIGHT - 1
		local displacement = 0
		if (x % 2 ~= 0) then
			vlimit = BOARDHEIGHT - 2
			displacement = 0 --BLOCKSIZE / 2
		end
		for y = 0, vlimit do
			pos.y = BOTTOM_EDGE + BLOCKSIZE / 2 + BLOCKSIZE * y + displacement
local ch = math.random(65, 90)
			local id = factory.create("#chip_factory", pos, nil, { symb = ch })

			board[x][y] = { id = id, x = x, y = y, symb = ch, type = TYPE_PLAIN }
		end
	end
	return board
end


--
-- Apply shift-down logic to all slots on the board, then
-- call the callback.
--
local function collapse_board(board, callback)
	local duration = 0.3
	--
	-- Slide all remaining blocks down into blank (nil) spots.
	-- Going column by column makes this easy.
	--
	-- Avoid some garbage creation by reusing these locals
	-- through the loops
	--
	local dy = 0
	local pos = vmath.vector3()
	for x = 0, BOARDWIDTH - 1 do
		--
		-- Reset the drop down distance for each column
		--
		dy = 0
		for y = 0, BOARDHEIGHT - 1 do
			if board[x][y] ~= nil then
				if dy > 0 then
					--
					-- Move down dy steps
					--
					board[x][y - dy] = board[x][y]
					board[x][y] = nil

					-- local ch = math.random(65,90)
					-- local id = factory.create("#chip_factory", board[x][y].pos, nil, { symb = ch })

					-- board[x][y] = { id = id, x = x, y = y, symb = ch, type = type }

					--
					-- Calc new position and animate
					---
					board[x][y - dy].y = board[x][y - dy].y - dy
					go.animate(board[x][y-dy].id, "position.y", go.PLAYBACK_ONCE_FORWARD, BOTTOM_EDGE + BLOCKSIZE / 2 + BLOCKSIZE * (y - dy), go.EASING_OUTBOUNCE, duration)
				end
			else
				--
				-- Empty slot - increase the distance to move
				--
				dy = dy + 1
			end
		end
	end

end


--
-- Return an iterator function for all non-empty slots
--
local function iterate_chips(board)
	local x = 0
	local y = -1
	return function()
		repeat
			y = y + 1
			if x == BOARDWIDTH - 1 and y == BOARDHEIGHT then
				return nil
			end

			if y == BOARDHEIGHT then
				y = 0
				x = x + 1
			end
		until board[x][y]
		return board[x][y]
	end
end


--
-- Remove a single chip from the board
--
local function remove_chip(board, chip)
	if not board[chip.x][chip.y] then
		-- the chip has already been removed
		-- this can happen when we remove a match and a line blast or
		-- other special effect takes place at the same time
		return
	end

	msg.post(chip.id, "remove")
	--
	-- Empty slots are set to nil so we can find them
	--
	board[chip.x][chip.y] = nil

	--
	-- Horisontal lineblast
	--
--	if chip.type == TYPE_STRIPED_H then
--		for x=0, BOARDWIDTH -1 do
--			if board[x][chip.y] then
--				remove_chip(board, board[x][chip.y])
--			end
--		end
	--
	-- Vertical lineblast
	--
	-- Wrapped explosion - remove all adjacent chip
	--
	-- Bomb
	--
	-- elseif chip.type == type_bomb then
		-- print("removing bomb - add code to remove chips")
--	end
end


--
-- Remove a list of chips from the board
--
local function remove_chips(board, chips)
	for _,chip in pairs(chips) do
		remove_chip(board, chip)
	end
end


--
-- Change type and color of an existing fish
-- Use this when converting fishes into other types due
-- to a match of some kind
-- Will clear list of neighbors
--
local function respawn(chip, type, symb)
	chip.symb = symb
	chip.type = type
	chip.neighbors_vertical = {}
	chip.neighbors_horisontal = {}
	msg.post(chip.id, "respawn", { symb = chip.symb, type = chip.type, position = go.get_position(chip.id) })
end

--
-- Remove all chips in a link
--
local function remove_link(board, link, callback)
	-- reset the animation on all fish in the link
	for _,slot in pairs(link) do
		msg.post(slot.id, "reset")
	end
	-- ignore short links
	if #link < 3 then
		callback()
		return
	end
	-- create special chip of the link is long enough
--	if #link > 6 then
--		local chip = table.remove(link)
--		respawn(chip, type_wrapped, chip.symb)
--	end
	-- remove chip and wait before invoking callback
	remove_chips(board, link)
	timer.delay(0.3, false, callback)
end


--
-- Add a slot to the link
--
local function add_to_link(self, x, y)
	-- outside board or empty
	if x < 0 or x >= BOARDWIDTH or y < 0 or y >= BOARDHEIGHT or self.board[x][y] == nil then
		return
	end

	local slot = self.board[x][y]

	-- add the first slot to the link without any checks
	if #self.link == 0 then
		msg.post(slot.id, "zoom_and_wobble")
		table.insert(self.link, slot)
		return
	end

	local last = self.link[#self.link]
	local previous = self.link[#self.link - 1]
	local distance = math.max(math.abs(last.x - x), math.abs(last.y - y))
	-- don't add the same slot more than once and don't add slots that are too far away
	if distance ~= 1 then
		return
	end
	-- don't add slots of a different color
	if last.symb ~= slot.symb then
		return
	end
	-- going back to the previous link
	-- remove the last slot of the link
	if previous == slot then
		self.link[#self.link] = nil
		msg.post(last.id, "reset")
		return
	end
	-- don't try to add the same slot twice
	for i = 1, #self.link do
		if self.link[i] == slot then
			return
		end
	end
	-- the new slot is ok, add it
	msg.post(slot.id, "zoom_and_wobble")
	table.insert(self.link, slot)
end


--
-- Find and return any empty slots.
--
local function empty_slots(board)
	local slots = {}
	for x = 0, BOARDWIDTH - 1 do
		for y = 0, BOARDHEIGHT - 1 do
			if board[x][y] == nil then
				--
				-- The slot is nil/empty so we store this position in the
				-- list of slots that we will return
				--
				table.insert(slots, { x = x, y = y })
			end
		end
	end
	return slots
end

--
-- Drop spawned chip to the board. Target the supplied slots.
-- When done, call callback.
--
local function fill_slots(board, empty_slots, callback)
	local duration = 0.3
	--
	-- Go through the list of empty slots and drop a (reused) chip
	-- game object into its position.
	--
	local pos = vmath.vector3()	-- Reuse through loop
	for i, s in pairs(empty_slots) do
		--
		-- Calc the x position of this slot
		--
		pos.x = EDGE + BLOCKSIZE / 2 + BLOCKSIZE * s.x
		--
		-- Start above the screen so we can animate into place
		--
		pos.y = 1000
		--
		-- Pick a random chip
		--
		local symb = math.random(65, 90)
		local type = TYPE_PLAIN
		--
		-- Create a new fish game object
		--
		local id = factory.create("#chip_factory", pos, nil, { symb = symb })
		--
		-- Animate into the slot's calculated y position
		--
		go.animate(id, "position.y", go.PLAYBACK_ONCE_FORWARD, BOTTOM_EDGE + BLOCKSIZE / 2 + BLOCKSIZE * s.y, go.EASING_OUTBOUNCE, duration)
		--
		-- Store the new data in the slot (it was nil)
		--
		board[s.x][s.y] = { id = id, type = type, symb = symb, x = s.x, y = s.y }
	end

	timer.delay(1, false, callback)
end

--
-- MESSAGE HANDLING
--
function on_message(self, message_id, message, sender)
	if message_id == hash("start_level") then
		--
		-- Create a new random board
		--
		self.board = build_board()
	elseif message_id == hash("post-reaction") then
		--
		-- Collapse any remaining slots
		--
		collapse_board(self.board, function ()
			--
			-- Find empty slots
			--
			local s = empty_slots(self.board)

			--
			-- If there are empty slots, fill them.
			--
			if #s > 0 then
				fill_slots(self.board, s, function ()
					--
					-- After filling
					--
				end)
			end
		end)
	end
end


--
-- INPUT HANDLING
--
function on_input(self, action_id, action)
	if action_id == hash("touch") or self.linking then
		local world = camera.screen_xy_to_world(action.screen_x, action.screen_y, "camera#camera")
		--
		-- What block was touched?
		--
		local x = math.floor((world.x - EDGE) / BLOCKSIZE)
		local y = math.floor((world.y - EDGE) / BLOCKSIZE)

		--
		-- Try to add it to the link
		--
		add_to_link(self, x, y)

		-- Start linking
		if action.pressed then
			self.linking = true
		-- Stop linking remove link
		elseif action.released then
			remove_link(self.board, self.link, function()
				self.linking = false
				self.link = {}
				msg.post("#", "post-reaction")
			end)
		end
	end
end
