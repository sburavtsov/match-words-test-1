local monarch = require("monarch.monarch")
local nodes = {}

local function update_value_text(self)
	gui.set_text(nodes.difficulty_label, "Сложность: " .. string.format("%.2f", self.slider_value_num))
end

local function set_slider_position(self, value)
	value = math.max(0, math.min(1, value))
	self.slider_value_num = value
	local x = self.slider_min_x + value * (self.slider_max_x - self.slider_min_x)
	gui.set_position(nodes.slider_thumb, vmath.vector3(x, self.slider_y, 0.1))
	update_value_text(self)
end

function init(self)
	nodes.targets_text = gui.get_node("targets_text")
	nodes.moves_text = gui.get_node("moves_text")
	nodes.pending_text = gui.get_node("pending_text")
	nodes.word_text = gui.get_node("word_text")
	nodes.difficulty_label = gui.get_node("difficulty_label")
	nodes.slider_track = gui.get_node("slider_track")
	nodes.slider_thumb = gui.get_node("slider_thumb")
	nodes.restart_btn = gui.get_node("restart_btn")
	nodes.anagramm_btn = gui.get_node("anagramm_btn")
	nodes.app_store_btn = gui.get_node("app_store_btn")

	local track_pos = gui.get_position(nodes.slider_track)
	local track_size = gui.get_size(nodes.slider_track)
	self.slider_min_x = track_pos.x - track_size.x / 2
	self.slider_max_x = track_pos.x + track_size.x / 2
	self.slider_y = track_pos.y

	self.slider_value_num = 0.0
	gui.set_position(nodes.slider_thumb, vmath.vector3(self.slider_min_x, self.slider_y, 0.1))
	update_value_text(self)
	self.hidden = false

	msg.post(".", "acquire_input_focus")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("update_hud") then
		if self.hidden then return end
		local active_str = ""
		if message.active_targets and #message.active_targets > 0 then
			for i = 1, #message.active_targets do
				if i > 1 then
					active_str = active_str .. " "
				end
				active_str = active_str .. message.active_targets[i]
			end
		else
			active_str = "—"
		end
		gui.set_text(nodes.targets_text, "Цели: " .. active_str)

		gui.set_text(nodes.moves_text, "Ходы: " .. tostring(message.idle_moves or 0))

		local pending_str = ""
		if message.pending_targets and #message.pending_targets > 0 then
			for i = 1, #message.pending_targets do
				if i > 1 then
					pending_str = pending_str .. " "
				end
				pending_str = pending_str .. message.pending_targets[i]
			end
		else
			pending_str = "—"
		end
		gui.set_text(nodes.pending_text, "В очереди: " .. pending_str)

		gui.set_text(nodes.word_text, message.current_word or "")

		local difficulty = message.difficulty or 0.0
		set_slider_position(self, difficulty)
	elseif message_id == hash("hide") then
		self.hidden = true
		gui.set_enabled(nodes.targets_text, false)
		gui.set_enabled(nodes.moves_text, false)
		gui.set_enabled(nodes.pending_text, false)
		gui.set_enabled(nodes.word_text, false)
		gui.set_enabled(nodes.difficulty_label, false)
		gui.set_enabled(nodes.slider_track, false)
		gui.set_enabled(nodes.slider_thumb, false)
		gui.set_enabled(nodes.restart_btn, false)
		gui.set_enabled(nodes.anagramm_btn, false)
		gui.set_enabled(nodes.app_store_btn, false)
	elseif message_id == hash("show") then
		self.hidden = false
		gui.set_enabled(nodes.targets_text, true)
		gui.set_enabled(nodes.moves_text, true)
		gui.set_enabled(nodes.pending_text, true)
		gui.set_enabled(nodes.word_text, true)
		gui.set_enabled(nodes.difficulty_label, true)
		gui.set_enabled(nodes.slider_track, true)
		gui.set_enabled(nodes.slider_thumb, true)
		gui.set_enabled(nodes.restart_btn, true)
		gui.set_enabled(nodes.anagramm_btn, true)
		gui.set_enabled(nodes.app_store_btn, true)
	end
end

function on_input(self, action_id, action)
	if action_id == hash("touch") then
		if action.released then
			if not self.dragging and gui.pick_node(nodes.restart_btn, action.x, action.y) then
				msg.post("main:/main#script", "restart", { difficulty = self.slider_value_num })
			elseif not self.dragging and gui.pick_node(nodes.anagramm_btn, action.x, action.y) then
				msg.post("main:/main#script", "hide_game_core")
				monarch.show("meta_anagram", { clear = true })
			elseif not self.dragging and gui.pick_node(nodes.app_store_btn, action.x, action.y) then
				msg.post("main:/main#script", "hide_game_core")
				monarch.show("app_store", { no_stack = true })
			end
			self.dragging = false
		elseif action.pressed then
			if gui.pick_node(nodes.slider_thumb, action.x, action.y) then
				local thumb_pos = gui.get_position(nodes.slider_thumb)
				self.drag_offset_x = action.x - thumb_pos.x
				self.dragging = true
			elseif gui.pick_node(nodes.slider_track, action.x, action.y) then
				self.drag_offset_x = 0
				self.dragging = true
			end
		end

		if self.dragging then
			local target_x = action.x - (self.drag_offset_x or 0)
			local x = math.max(self.slider_min_x, math.min(self.slider_max_x, target_x))
			self.slider_value_num = (x - self.slider_min_x) / (self.slider_max_x - self.slider_min_x)
			gui.set_position(nodes.slider_thumb, vmath.vector3(x, self.slider_y, 0.1))
			update_value_text(self)
			msg.post("main:/main#script", "set_difficulty", { difficulty = self.slider_value_num })
		end
	end
end